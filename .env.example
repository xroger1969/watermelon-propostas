# Viator Partner API key (Affiliate/Merchant Partner API)
# Do not commit the real key. Configure it in Vercel Environment Variables.
VIATOR_PARTNER_API_KEY=

# GetYourGuide Partner API
# Request partner access from GetYourGuide. Keep the real token server-side.
GETYOURGUIDE_PARTNER_API_TOKEN=
# Comma-separated GetYourGuide tour IDs to expose through the Watermelon adapter.
GETYOURGUIDE_TOUR_IDS=
# Commercial contact for the GetYourGuide partnership application.
GETYOURGUIDE_PARTNER_CONTACT_EMAIL=info@watermelonexperiences.pt

# Supabase booking/admin project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google marketing / advertising (public IDs only — configure in Vercel)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PROPOSAL_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AI_LEAD_LABEL=
NEXT_PUBLIC_GA4_ID=

# Transactional customer email from the private CRM
RESEND_API_KEY=
CRM_EMAIL_FROM=Watermelon Experiences <info@watermelonexperiences.pt>
