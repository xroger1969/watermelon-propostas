# Watermelon Product Studio - GetYourGuide Supplier Connectivity
# Do not put real passwords or tokens in Git; set them in Vercel Environment Variables.
# Off by default. Sandbox must never be configured on a domain accessible as production.
GYG_SUPPLIER_MODE=off
GYG_SUPPLIER_ENABLED=false
GYG_SUPPLIER_BASIC_USER=
GYG_SUPPLIER_BASIC_PASSWORD=
# GYG Supplier API only after homologation and separate deployment (NOT currently enabled)
GYG_SUPPLIER_APPROVED=false
GYG_SUPPLIER_CONNECTIVITY_CERTIFIED=false

# Existing Studio server-to-server connection
SUPABASE_PRODUCT_STUDIO_URL=
PRODUCT_STUDIO_INTERNAL_KEY=

# Outbound availability notification: always off until certified, and inventory change outbox is built.
GYG_NOTIFY_MODE=off
GYG_NOTIFY_ENABLED=false
GYG_OUTBOUND_BASIC_USER=
GYG_OUTBOUND_BASIC_PASSWORD=
